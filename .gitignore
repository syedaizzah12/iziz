.DS_Store
# Cloud sessions are deleted after inactivity, so finished films in videos/<slug>/renders are committed.
# Test renders and heavy intermediates stay out of git.
videos/_test-*/
videos/*/renders/draft_*.mp4
videos/*/renders/clip_*.mp4
videos/*/review/
# download copies of the committed renders (same bytes, friendlier names)
videos/*/renders/orem-reel-*.mp4
